# Скопируй в .env.render и подставь значения с Render (файл .env.render не коммитится).
# Запуск импорта в прод-БД без Shell:
#   PowerShell:  .\tools\run_render_import.ps1
#   Bash:        JOBFLEX_USE_RENDER_DB=1 python manage.py render_prod_smoke
#
# Postgres → Connect → External Database URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
# Web service → Environment → DJANGO_SECRET_KEY
DJANGO_SECRET_KEY=
DEPLOY_ENV=production
DJANGO_DEBUG=false
HH_IMPORT_TOTAL_CAP=1000
